<%- include('partials/header') %>
<%- include('partials/shop-nav') %>

<!-- Hero Card -->
<div class="glass-card w-full max-w-4xl mx-auto p-8 md:p-14 text-center transform transition-all hover:scale-[1.01] duration-500">
    <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-slate-900 shadow-[0_0_50px_rgba(239,31,31,0.25)] border border-slate-800 mb-8">
        <i class="fa-solid fa-key text-4xl text-white"></i>
    </div>

    <h1 class="text-5xl md:text-6xl font-bold text-white mb-3 tracking-tight">Key <span class="text-primary">Shop</span></h1>
    <p class="text-lg text-slate-400 mb-2">Premium License Keys • Instant Delivery</p>
    <div class="flex items-center justify-center gap-2 text-sm text-slate-500 mb-12">
        <i class="fa-solid fa-bolt text-primary"></i>
        <span>Delivered via Email & Discord</span>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6 mb-12">
        <div class="bg-slate-900/40 backdrop-blur-sm p-6 rounded-2xl border border-slate-800/50 hover:border-primary/30 transition-all duration-300">
            <div class="w-12 h-12 mx-auto rounded-xl bg-slate-800 flex items-center justify-center mb-4">
                <i class="fa-regular fa-calendar-check text-2xl text-primary"></i>
            </div>
            <h3 class="text-white font-semibold mb-1">Custom Expiry</h3>
            <p class="text-xs text-slate-400">Pick any date you need</p>
        </div>
        <div class="bg-slate-900/40 backdrop-blur-sm p-6 rounded-2xl border border-slate-800/50 hover:border-primary/30 transition-all duration-300">
            <div class="w-12 h-12 mx-auto rounded-xl bg-slate-800 flex items-center justify-center mb-4">
                <i class="fa-solid fa-laptop text-2xl text-primary"></i>
            </div>
            <h3 class="text-white font-semibold mb-1">Multi‑Device</h3>
            <p class="text-xs text-slate-400">Set maximum devices</p>
        </div>
        <div class="bg-slate-900/40 backdrop-blur-sm p-6 rounded-2xl border border-slate-800/50 hover:border-primary/30 transition-all duration-300">
            <div class="w-12 h-12 mx-auto rounded-xl bg-slate-800 flex items-center justify-center mb-4">
                <i class="fa-brands fa-discord text-2xl text-primary"></i>
            </div>
            <h3 class="text-white font-semibold mb-1">Discord DM</h3>
            <p class="text-xs text-slate-400">Key instantly to DM</p>
        </div>
    </div>

    <!-- Price & CTA -->
    <div class="flex flex-col items-center">
        <p class="text-2xl font-medium text-white mb-4">
            Starting at <span class="text-primary font-bold text-3xl">₹<%= settings.perDayPrice %></span><span class="text-slate-400 text-lg">/day</span>
        </p>
        <% if (typeof user !== 'undefined' && user) { %>
            <a href="/shop/purchase" class="btn-primary text-lg px-10 py-4">
                <i class="fa-solid fa-cart-shopping"></i> Buy Now
            </a>
        <% } else { %>
            <a href="/auth/login" class="btn-primary text-lg px-10 py-4">
                <i class="fa-solid fa-lock"></i> Login to Purchase
            </a>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>