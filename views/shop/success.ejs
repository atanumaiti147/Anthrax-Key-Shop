<%- include('../partials/header') %>
<%- include('../partials/shop-nav') %>

<div class="glass-card w-full max-w-lg mx-auto p-8 md:p-10 text-center">
    <div class="w-20 h-20 mx-auto rounded-full bg-green-500/10 border border-green-500/30 flex items-center justify-center mb-6">
        <i class="fa-solid fa-check-circle text-5xl text-green-400"></i>
    </div>
    <h1 class="text-3xl font-bold text-white mb-2">Payment Successful!</h1>
    <p class="text-slate-400 text-sm mb-6">Your license key has been generated</p>
    <div class="bg-slate-900/50 rounded-xl p-4 mb-6">
        <p class="text-xs text-slate-400 mb-1">License Key</p>
        <div class="flex items-center justify-center gap-2 mb-2">
            <code id="keyDisplay" class="text-green-300 font-mono text-lg select-all break-all"><%= typeof key !== 'undefined' ? key : 'N/A' %></code>
            <button onclick="copyKey()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-copy"></i></button>
        </div>
        <p class="text-xs text-slate-500">Check your email and Discord (if provided).</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="btn-primary flex-1 py-2.5 text-sm"><i class="fa-solid fa-home"></i> Home</a>
        <a href="/shop/orders" class="btn-primary !bg-slate-700 hover:!bg-slate-600 flex-1 py-2.5 text-sm"><i class="fa-solid fa-list"></i> My Orders</a>
    </div>
</div>

<script>
    async function copyKey() {
        const key = document.getElementById('keyDisplay').textContent;
        await navigator.clipboard.writeText(key);
        alert('Key copied!');
    }
</script>

<%- include('../partials/footer') %>