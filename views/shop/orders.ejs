<%- include('../partials/header') %>

<% if (typeof settings !== 'undefined' && settings.faviconUrl) { %>
    <link rel="icon" href="<%= settings.faviconUrl %>" type="image/x-icon">
<% } %>

<%- include('../partials/shop-nav') %>

<div class="w-full max-w-4xl mx-auto glass-card p-6">
    <h2 class="text-2xl font-bold text-white mb-6">Your Orders</h2>
    <% if (orders.length === 0) { %>
        <p class="text-slate-400">No orders yet. <a href="/shop/purchase" class="text-primary hover:underline">Buy a key</a></p>
    <% } else { %>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="text-xs text-slate-400 uppercase bg-slate-900/50">
                    <tr>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4">Expiry</th>
                        <th class="px-6 py-4">Amount</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Key</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(order => { %>
                        <tr class="border-b border-slate-800 hover:bg-slate-800/50">
                            <td class="px-6 py-4"><%= order.createdAt.toLocaleDateString() %></td>
                            <td class="px-6 py-4"><%= new Date(order.keyDetails.expiryDate).toLocaleDateString() %></td>
                            <td class="px-6 py-4">₹<%= Number(order.amount).toFixed(2) %></td>
                            <td class="px-6 py-4">
                                <% if (order.status === 'paid') { %>
                                    <span class="bg-emerald-500/10 text-emerald-500 text-xs font-medium px-2.5 py-1 rounded-full border border-emerald-500/20">paid</span>
                                <% } else if (order.status === 'pending') { %>
                                    <span class="bg-amber-500/10 text-amber-500 text-xs font-medium px-2.5 py-1 rounded-full border border-amber-500/20">pending</span>
                                <% } else { %>
                                    <span class="bg-slate-500/10 text-slate-400 text-xs font-medium px-2.5 py-1 rounded-full border border-slate-500/20"><%= order.status %></span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4 text-emerald-400 font-mono text-xs">
                                <% if (order.transferred) { %>
                                    <span class="text-slate-400 italic text-xs">Transferred to <%= order.transferredToEmail || order.transferredToDiscordUsername %></span>
                                <% } else if (order.status === 'paid' && order.generatedKey) { %>
                                    <%= order.generatedKey %>
                                <% } else { %>
                                    N/A
                                <% } %>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <% if (order.status === 'paid' && order.generatedKey) { %>
                                    <div class="flex items-center justify-end gap-2">
                                        <% if (!order.transferred) { %>
                                        <a href="/shop/renew/<%= order._id %>" class="text-primary hover:text-primary-hover text-xs font-medium">
                                            <i class="fa-solid fa-arrows-rotate mr-1"></i> Renew
                                        </a>
                                        <a href="/shop/transfer/<%= order._id %>" class="text-primary hover:text-primary-hover text-xs font-medium">
                                            <i class="fa-solid fa-arrow-right-arrow-left mr-1"></i> Transfer
                                        </a>
                                        <% } %>
                                        <a href="/shop/invoice/<%= order._id %>" class="text-primary hover:text-primary-hover text-xs font-medium" title="Download Invoice">
                                            <i class="fa-solid fa-file-pdf mr-1"></i> Invoice
                                        </a>
                                    </div>
                                <% } else { %>
                                    <span class="text-slate-500 text-xs">—</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
