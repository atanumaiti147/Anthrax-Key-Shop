<%- include('../partials/header') %>
<%- include('../partials/shop-nav') %>

<div class="w-full max-w-md mx-auto glass-card p-8">
    <h2 class="text-2xl font-bold text-white mb-6">Transfer License Key</h2>
    <div class="bg-slate-900/40 p-4 rounded-xl mb-6">
        <p class="text-slate-400 text-sm">Key: <code class="text-green-300"><%= order.generatedKey %></code></p>
        <p class="text-slate-400 text-sm">Expires: <%= new Date(order.keyDetails.expiryDate).toLocaleDateString() %></p>
    </div>

    <form action="/shop/transfer/<%= order._id %>" method="POST" class="space-y-4">
        <div>
            <label class="text-sm text-slate-300">New Owner's Email</label>
            <input type="email" name="email" class="input-field mt-1" required>
        </div>
        <div>
            <label class="text-sm text-slate-300">New Owner's Discord Username (optional)</label>
            <input type="text" name="discordUsername" class="input-field mt-1">
        </div>
        <button type="submit" class="btn-primary w-full py-3">Transfer Key</button>
    </form>
</div>

<%- include('../partials/footer') %>