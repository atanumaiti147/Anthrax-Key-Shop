<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (typeof settings !== 'undefined' && settings.siteName) ? settings.siteName : 'Key Shop' %></title>
    <link rel="icon" href="<%= (typeof settings !== 'undefined' && settings.faviconUrl) ? settings.faviconUrl : '/favicon.ico' %>" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: { DEFAULT: '#ef1f1f', hover: '#d41919', dark: '#b01414' },
                        darkbase: '#0f172a',
                        darkcard: 'rgba(30, 41, 59, 0.7)'
                    }
                }
            }
        }
    </script>
    <style>
        .glass-card { background: rgba(30,41,59,0.7); backdrop-filter: blur(24px); border: 1px solid rgba(255,255,255,0.1); border-radius: 1.5rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); }
        .btn-primary { background: linear-gradient(135deg, #ef1f1f, #b91c1c); color: white; font-weight: 600; padding: 0.75rem 2rem; border-radius: 0.75rem; transition: all 0.3s; box-shadow: 0 8px 20px rgba(239,31,31,0.3); display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; border: none; cursor: pointer; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(239,31,31,0.5); }
        .input-field { width: 100%; background: rgba(15,23,42,0.6); border: 1px solid #334155; border-radius: 0.75rem; padding: 0.75rem 1rem; color: #f1f5f9; transition: all 0.3s; }
        .input-field:focus { outline: none; border-color: #ef1f1f; box-shadow: 0 0 0 1px rgba(239,31,31,0.5); }

        /* Toast Notifications */
        #toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
        }
        .toast {
            background: rgba(30, 41, 59, 0.9);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,0.2);
            border-left: 4px solid #10b981;
            color: #fff;
            padding: 16px 20px;
            border-radius: 12px;
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 280px;
            max-width: 400px;
            animation: slideInRight 0.4s ease, fadeOut 0.5s ease 3.5s forwards;
            pointer-events: auto;
        }
        .toast.error {
            border-left-color: #ef4444;
        }
        .toast i {
            font-size: 1.5rem;
        }
        .toast .msg {
            flex: 1;
            font-size: 0.95rem;
        }
        .toast .close-btn {
            cursor: pointer;
            opacity: 0.7;
            transition: 0.2s;
        }
        .toast .close-btn:hover {
            opacity: 1;
        }
        @keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes fadeOut {
            from { opacity: 1; }
            to { opacity: 0; visibility: hidden; }
        }
    </style>
</head>
<body class="bg-darkbase text-slate-200 min-h-screen flex flex-col">

    <!-- Toast Container -->
    <div id="toast-container"></div>

    <!-- 🆕 ANNOUNCEMENT BANNER -->
    <% if (typeof announcement !== 'undefined' && announcement) { %>
    <div id="announcementBanner" class="w-full bg-primary/90 text-white text-center py-3 px-4 relative">
        <p class="text-sm md:text-base font-medium">
            <%= announcement.message %>
            <span id="announceTimer" class="font-bold ml-2"></span>
        </p>
        <button onclick="document.getElementById('announcementBanner').remove()" class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-70 hover:opacity-100">
            <i class="fa-solid fa-times"></i>
        </button>
    </div>
    <script>
        (function() {
            const endDate = new Date("<%= announcement.endDate.toISOString() %>").getTime();
            const timerEl = document.getElementById('announceTimer');
            const interval = setInterval(() => {
                const now = Date.now();
                const distance = endDate - now;
                if (distance <= 0) {
                    clearInterval(interval);
                    timerEl.textContent = '(Ended)';
                    return;
                }
                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                timerEl.textContent = `Ends in ${days}d ${hours}h ${minutes}m ${seconds}s`;
            }, 1000);
        })();
    </script>
    <% } %>

    <main class="flex-grow flex flex-col items-center justify-start p-4 md:p-6">