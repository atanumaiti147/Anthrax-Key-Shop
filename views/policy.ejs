<%- include('partials/header') %>
<%- include('partials/shop-nav') %>

<div class="w-full max-w-4xl mx-auto glass-card p-8 md:p-10">
    <a href="/" class="inline-flex items-center text-slate-400 hover:text-white mb-6 text-sm">
        <i class="fa-solid fa-arrow-left mr-2"></i> Back to Home
    </a>
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-2"><%= policy.title %></h1>
    <p class="text-slate-500 text-xs mb-6">Last updated: <%= policy.updatedAt.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <div class="text-slate-300 leading-relaxed max-w-none">
        <% if (policy.contentType === 'html') { %>
            <%- policy.content %>
        <% } else { %>
            <p style="white-space: pre-wrap;"><%= policy.content %></p>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>