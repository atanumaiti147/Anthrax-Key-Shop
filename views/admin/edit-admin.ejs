<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<div class="w-full max-w-md mx-auto glass-card p-8">
    <h2 class="text-2xl font-bold text-white mb-6">Edit Admin</h2>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-500/10 border border-red-500/30 text-red-300 p-4 rounded-xl mb-4"><%= error %></div>
    <% } %>
    <form action="/admin/edit-admin/<%= admin._id %>" method="POST" class="space-y-5">
        <div>
            <label class="text-sm text-slate-300">Email</label>
            <input type="email" name="email" value="<%= admin.email %>" required class="input-field mt-1">
        </div>
        <div>
            <label class="text-sm text-slate-300">New Password (leave blank to keep current)</label>
            <input type="password" name="password" class="input-field mt-1" placeholder="Enter new password">
        </div>
        <div>
            <label class="text-sm text-slate-300">Role</label>
            <select name="role" class="input-field mt-1">
                <option value="admin" <%= admin.role === 'admin' ? 'selected' : '' %>>Admin</option>
                <option value="super_admin" <%= admin.role === 'super_admin' ? 'selected' : '' %>>Super Admin</option>
            </select>
        </div>
        <button type="submit" class="btn-primary w-full py-2.5">Save Changes</button>
    </form>
</div>

<%- include('../partials/footer') %>