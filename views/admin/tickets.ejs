<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<div class="w-full max-w-6xl mx-auto glass-card p-6">
    <h2 class="text-xl font-bold text-white mb-4">Support Tickets</h2>
    <% if (tickets.length === 0) { %>
        <p class="text-slate-400">No tickets.</p>
    <% } else { %>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="text-xs text-slate-400 uppercase bg-slate-900/50">
                    <tr>
                        <th class="px-6 py-4">User</th>
                        <th class="px-6 py-4">Subject</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% tickets.forEach(ticket => { %>
                        <tr class="border-b border-slate-800 hover:bg-slate-800/50">
                            <td class="px-6 py-4"><%= ticket.userId?.email || 'N/A' %></td>
                            <td class="px-6 py-4"><%= ticket.subject %></td>
                            <td class="px-6 py-4"><%= ticket.status %></td>
                            <td class="px-6 py-4"><%= ticket.createdAt.toLocaleDateString() %></td>
                            <td class="px-6 py-4 text-right">
                                <% if (ticket.status === 'open') { %>
                                    <a href="/admin/tickets/close/<%= ticket._id %>" class="text-slate-400 hover:text-red-400">Close</a>
                                <% } else { %>
                                    <span class="text-slate-500">—</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>