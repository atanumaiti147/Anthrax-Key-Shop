<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<div class="w-full max-w-6xl mx-auto glass-card p-6">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-white">Announcements</h2>
        <a href="/admin/announcements/create" class="btn-primary px-4 py-2 text-sm"><i class="fa-solid fa-plus"></i> New Announcement</a>
    </div>

    <% if (announcements.length === 0) { %>
        <p class="text-slate-400">No announcements yet.</p>
    <% } else { %>
        <div class="space-y-4">
            <% announcements.forEach(a => { %>
                <div class="bg-slate-900/40 p-4 rounded-xl border border-slate-700 flex justify-between items-center">
                    <div>
                        <p class="text-white font-medium"><%= a.message %></p>
                        <p class="text-xs text-slate-400"><%= new Date(a.startDate).toLocaleString() %> → <%= new Date(a.endDate).toLocaleString() %></p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/admin/announcements/edit/<%= a._id %>" class="text-slate-400 hover:text-primary"><i class="fa-solid fa-pen"></i></a>
                        <a href="/admin/announcements/delete/<%= a._id %>" class="text-slate-400 hover:text-red-400"><i class="fa-solid fa-trash"></i></a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>