<%- include('../partials/header') %>

<!-- 🔒 Favicon override -->
<% if (typeof settings !== 'undefined' && settings.faviconUrl) { %>
    <link rel="icon" href="<%= settings.faviconUrl %>" type="image/x-icon">
<% } %>

<%- include('../partials/admin-nav') %>

<div class="w-full max-w-6xl mx-auto glass-card p-6">
    <h2 class="text-xl font-bold text-white mb-4">Registered Users</h2>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="text-xs text-slate-400 uppercase bg-slate-900/50">
                <tr>
                    <th class="px-6 py-4">Email</th>
                    <th class="px-6 py-4">Provider</th>
                    <th class="px-6 py-4">Username</th>
                    <th class="px-6 py-4">Joined</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                    <tr class="border-b border-slate-800 hover:bg-slate-800/50">
                        <td class="px-6 py-4"><%= user.email || 'N/A' %></td>
                        <td class="px-6 py-4"><%= user.provider %></td>
                        <td class="px-6 py-4"><%= user.username || 'N/A' %></td>
                        <td class="px-6 py-4"><%= user.createdAt.toLocaleDateString() %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<%- include('../partials/footer') %>