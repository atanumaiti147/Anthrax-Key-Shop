<%- include('../partials/header') %>

<!-- 🔒 Favicon override -->
<% if (typeof settings !== 'undefined' && settings.faviconUrl) { %>
    <link rel="icon" href="<%= settings.faviconUrl %>" type="image/x-icon">
<% } %>

<div class="min-h-screen flex items-center justify-center bg-darkbase p-4">
    <div class="glass-card w-full max-w-md p-8 md:p-10 text-center">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-slate-900 shadow-[0_0_30px_rgba(239,31,31,0.2)] border border-slate-800 mb-6">
            <i class="fa-solid fa-shield-halved text-3xl text-white"></i>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">Admin Portal</h1>
        <p class="text-slate-400 text-sm mb-8">Authorized personnel only</p>
        <form action="/admin/login" method="POST" class="space-y-5">
            <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Email</label>
                <div class="relative">
                    <i class="fa-solid fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="email" name="email" required class="input-field pl-10" placeholder="admin@shop.com">
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Password</label>
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="password" name="password" required class="input-field pl-10" placeholder="••••••••">
                </div>
            </div>
            <% if (typeof error !== 'undefined' && error) { %><p class="text-red-400 text-sm"><%= error %></p><% } %>
            <button type="submit" class="btn-primary w-full py-3">Secure Login</button>
        </form>
    </div>
</div>
<%- include('../partials/footer') %>