<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<div class="w-full max-w-6xl mx-auto glass-card p-6">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-white">Coupons</h2>
        <div class="flex gap-2">
            <a href="/admin/coupons/bulk" class="btn-primary px-4 py-2 text-sm bg-slate-700 hover:bg-slate-600">
                <i class="fa-solid fa-layer-group mr-1"></i> Bulk Generate
            </a>
            <a href="/admin/coupons/create" class="btn-primary px-4 py-2 text-sm">
                <i class="fa-solid fa-plus"></i> New Coupon
            </a>
        </div>
    </div>

    <% if (coupons.length === 0) { %>
        <p class="text-slate-400">No coupons yet.</p>
    <% } else { %>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="text-xs text-slate-400 uppercase bg-slate-900/50">
                    <tr>
                        <th class="px-6 py-4">Code</th>
                        <th class="px-6 py-4">Discount</th>
                        <th class="px-6 py-4">Validity</th>
                        <th class="px-6 py-4">Used</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% coupons.forEach(c => { %>
                        <tr class="border-b border-slate-800 hover:bg-slate-800/50">
                            <td class="px-6 py-4 font-bold text-primary"><%= c.code %></td>
                            <td class="px-6 py-4"><%= c.discountType === 'percentage' ? c.discountValue + '%' : '₹' + c.discountValue %></td>
                            <td class="px-6 py-4"><%= new Date(c.startDate).toLocaleDateString() %> - <%= new Date(c.endDate).toLocaleDateString() %></td>
                            <td class="px-6 py-4"><%= c.usedCount %>/<%= c.maxUses || '∞' %></td>
                            <td class="px-6 py-4"><%= c.active ? 'Active' : 'Inactive' %></td>
                            <td class="px-6 py-4 text-right">
                                <a href="/admin/coupons/edit/<%= c._id %>" class="text-slate-400 hover:text-primary mr-2"><i class="fa-solid fa-pen"></i></a>
                                <a href="/admin/coupons/delete/<%= c._id %>" onclick="return confirm('Delete coupon?')" class="text-slate-400 hover:text-red-400"><i class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>