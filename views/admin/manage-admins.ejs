<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<div class="w-full max-w-6xl mx-auto glass-card p-6">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-white">Manage Administrators</h2>
        <a href="/admin/create-admin" class="btn-primary px-4 py-2 text-sm">
            <i class="fa-solid fa-plus"></i> Add Admin
        </a>
    </div>

    <% if (admins.length === 0) { %>
        <p class="text-slate-400">No admins found.</p>
    <% } else { %>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="text-xs text-slate-400 uppercase bg-slate-900/50">
                    <tr>
                        <th class="px-6 py-4">Email</th>
                        <th class="px-6 py-4">Role</th>
                        <th class="px-6 py-4">Created</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% admins.forEach(admin => { %>
                        <tr class="border-b border-slate-800 hover:bg-slate-800/50">
                            <td class="px-6 py-4"><%= admin.email %></td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-<%= admin.role === 'super_admin' ? 'purple' : 'blue' %>-500/10 text-<%= admin.role === 'super_admin' ? 'purple' : 'blue' %>-300 border border-<%= admin.role === 'super_admin' ? 'purple' : 'blue' %>-500/20">
                                    <%= admin.role.charAt(0).toUpperCase() + admin.role.slice(1) %>
                                </span>
                            </td>
                            <td class="px-6 py-4"><%= admin.createdAt ? new Date(admin.createdAt).toLocaleDateString() : 'N/A' %></td>
                            <td class="px-6 py-4 text-right">
                                <a href="/admin/edit-admin/<%= admin._id %>" class="text-slate-400 hover:text-primary mr-2"><i class="fa-solid fa-pen"></i></a>
                                <a href="/admin/delete-admin/<%= admin._id %>" onclick="return confirm('Delete this admin?')" class="text-slate-400 hover:text-red-400"><i class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>