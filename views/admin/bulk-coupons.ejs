<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<div class="w-full max-w-2xl mx-auto glass-card p-8">
    <h2 class="text-2xl font-bold text-white mb-6">Bulk Coupon Generation</h2>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-500/10 border border-red-500/30 text-red-300 p-4 rounded-xl mb-4"><%= error %></div>
    <% } %>
    <form action="/admin/coupons/bulk" method="POST" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="text-sm text-slate-300">Prefix (e.g., SUMMER)</label>
                <input type="text" name="prefix" value="" class="input-field mt-1" placeholder="SUMMER">
            </div>
            <div>
                <label class="text-sm text-slate-300">Number of Coupons (1-500)</label>
                <input type="number" name="count" value="10" min="1" max="500" required class="input-field mt-1">
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="text-sm text-slate-300">Discount Type</label>
                <select name="discountType" class="input-field mt-1">
                    <option value="percentage">Percentage</option>
                    <option value="fixed">Fixed Amount</option>
                </select>
            </div>
            <div>
                <label class="text-sm text-slate-300">Discount Value</label>
                <input type="number" name="discountValue" step="0.01" value="10" required class="input-field mt-1">
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="text-sm text-slate-300">Min. Order Amount (₹)</label>
                <input type="number" name="minOrderAmount" value="0" class="input-field mt-1">
            </div>
            <div>
                <label class="text-sm text-slate-300">Max Uses (0 = unlimited)</label>
                <input type="number" name="maxUses" value="1" class="input-field mt-1">
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="text-sm text-slate-300">Min. Devices Required</label>
                <input type="number" name="minDevices" value="0" class="input-field mt-1">
            </div>
            <div class="flex items-center gap-2 mt-6">
                <input type="checkbox" name="oncePerUser" id="oncePerUser" class="w-4 h-4 text-primary bg-slate-700 rounded">
                <label for="oncePerUser" class="text-sm text-slate-300">One‑time per user</label>
            </div>
        </div>
        <div>
            <label class="text-sm text-slate-300">Allowed Emails (comma separated, leave empty for all)</label>
            <textarea name="allowedEmails" rows="2" class="input-field mt-1" placeholder="email1@example.com, email2@example.com"></textarea>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="text-sm text-slate-300">Start Date</label>
                <input type="datetime-local" name="startDate" required class="input-field mt-1">
            </div>
            <div>
                <label class="text-sm text-slate-300">End Date</label>
                <input type="datetime-local" name="endDate" required class="input-field mt-1">
            </div>
        </div>
        <label class="flex items-center gap-2">
            <input type="checkbox" name="active" checked class="w-4 h-4 text-primary bg-slate-700 rounded">
            <span class="text-sm text-slate-300">Active</span>
        </label>
        <button type="submit" class="btn-primary px-6 py-3">Generate Coupons</button>
    </form>
</div>

<%- include('../partials/footer') %>