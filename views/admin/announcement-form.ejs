<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<div class="w-full max-w-2xl mx-auto glass-card p-8">
    <h2 class="text-2xl font-bold text-white mb-6"><%= announcement ? 'Edit' : 'New' %> Announcement</h2>
    <form action="/admin/announcements/<%= announcement ? 'edit/' + announcement._id : 'create' %>" method="POST" class="space-y-6">
        <div>
            <label class="text-sm text-slate-300">Message</label>
            <textarea name="message" rows="3" required class="input-field mt-1"><%= announcement ? announcement.message : '' %></textarea>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="text-sm text-slate-300">Start Date</label>
                <input type="datetime-local" name="startDate" value="<%= announcement ? announcement.startDate.toISOString().slice(0,16) : '' %>" required class="input-field mt-1">
            </div>
            <div>
                <label class="text-sm text-slate-300">End Date</label>
                <input type="datetime-local" name="endDate" value="<%= announcement ? announcement.endDate.toISOString().slice(0,16) : '' %>" required class="input-field mt-1">
            </div>
        </div>
        <label class="flex items-center gap-2">
            <input type="checkbox" name="active" <%= announcement ? (announcement.active ? 'checked' : '') : 'checked' %> class="w-4 h-4 text-primary bg-slate-700 rounded">
            <span class="text-sm text-slate-300">Active</span>
        </label>
        <button type="submit" class="btn-primary px-6 py-3">Save Announcement</button>
    </form>
</div>

<%- include('../partials/footer') %>