<%- include('../partials/header') %>
<%- include('../partials/shop-nav') %>

<div class="w-full max-w-4xl mx-auto glass-card p-8">
    <h2 class="text-2xl font-bold text-white mb-6">Our Policies</h2>
    <div class="space-y-4">
        <% policies.forEach(policy => { %>
            <a href="/policy/<%= policy.slug %>" class="block bg-slate-800/50 hover:bg-slate-700/50 p-4 rounded-xl transition border border-slate-700">
                <h3 class="text-white font-medium"><%= policy.title %></h3>
                <p class="text-xs text-slate-400">Updated <%= policy.updatedAt.toLocaleDateString() %></p>
            </a>
        <% }) %>
    </div>
</div>

<%- include('../partials/footer') %>